<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <Match>
        <Bug pattern="SE_BAD_FIELD, SE_BAD_FIELD_STORE"/>
    </Match>
    <Match>
        <Class name="~.*\$package(\$)?" />
        <Bug pattern="NM_CLASS_NAMING_CONVENTION" />
    </Match>
    <!-- Falso positivo su TickBasedSelector: scala.Vector è immutabile -->
    <Match>
        <Class name="it.unibo.splague.simulation.event.TickBasedSelector" />
        <Bug pattern="EI_EXPOSE_REP2" />
    </Match>
    <!-- Esclude l'esposizione della rappresentazione per la classe SimulationEngineState -->
    <Match>
        <Class name="it.unibo.splague.update.Mvu$SimulationEngineState" />
        <Or>
            <Bug code="EI" />
            <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2" />
        </Or>
    </Match>
</FindBugsFilter>